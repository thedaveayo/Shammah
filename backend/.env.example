# Shammah backend configuration
# Copy to .env and fill in the values you need.

# Database
DATABASE_URL=sqlite:///./security_mcp.db

# Data sources and LLM
NVD_API_KEY=                # optional, https://nvd.nist.gov/developers/request-an-api-key
QWEN_API_KEY=               # any OpenAI-compatible key
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-flash
TELEGRAM_BOT_TOKEN=         # optional

# Admin key for /api/fetch/*, /api/rules/telegram and /api/quick-fix/suggest.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty to disable those routes.
ADMIN_API_KEY=

# Server
HOST=127.0.0.1
PORT=8000
BACKEND_URL=http://localhost:8000
SYNC_INTERVAL_HOURS=6
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Shammah MCP server configuration
# Copy to mcp-server/.env. Everything is optional: with no backend the server
# still works using its built-in starter rules.

# Backend to sync extra rules from (leave as is if you don't run one)
BACKEND_URL=http://localhost:8000
SYNC_TIMEOUT_SECONDS=10
AUTO_SYNC_ON_START=true

# Local rule cache (default: mcp-server/mcp_local.db)
# DATABASE_URL=sqlite:///C:/path/to/mcp_local.db

# Local HTTP bridge for IDE extensions (python main.py --bridge)
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8765

# Shammah Pro: full rule feed and dashboard (optional)
SHAMMAH_API_KEY=
SHAMMAH_FEED_URL=
